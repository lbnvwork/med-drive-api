###> Общие настройки приложения ###
APP_ENV=dev                # prod, dev, test
APP_DEBUG=1                # 1 для dev, 0 для prod
APP_SECRET=change_me       # замените на реальный ключ

###> Порты стека (внешние, на хосте) ###
APP_PORT=8108              # nginx → API
DB_PORT=5532               # PostgreSQL

###> База данных (PostgreSQL для Docker) ###
POSTGRES_USER=symfony
POSTGRES_PASSWORD=change_me
POSTGRES_DB=symfony
DATABASE_URL=postgresql://symfony:change_me@db:5432/symfony?serverVersion=15&charset=utf8

###> CORS ###
CORS_ALLOW_ORIGIN="^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$"

###> Версия приложения (SemVer) ###
# Источник истины — git-тег v<MAJOR>.<MINOR>.<PATCH>; в dev — "dev".
APP_VERSION=dev
